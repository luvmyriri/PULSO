# Copy to backend/.env and replace required placeholders locally.
# Keep the database name, user, password, and port aligned with the root .env.
DATABASE_URL=postgresql://<local_database_user>:<local_database_password>@127.0.0.1:5432/<local_database_name>
JWT_SECRET_KEY=<generate_a_unique_random_secret>
ALLOWED_ORIGINS=http://127.0.0.1:5173

# Optional external services. Configure only the integrations you use.
# OCR_API_KEY=<optional_ocr_api_key>
# GOOGLE_MAPS_API_KEY=<optional_maps_api_key>
# GOOGLE_VISION_API_KEY=<optional_vision_api_key>
# GOOGLE_GEMINI_API_KEY=<optional_gemini_api_key>
# Government conversation bubble; server-side only, never use a VITE_ variable.
# OPENAI_API_KEY=<your_openai_project_api_key>
# OPENAI_MODEL=gpt-4.1-mini
# GOOGLE_APPLICATION_CREDENTIALS=<optional_local_credentials_file_path>
# GOOGLE_CLOUD_PROJECT=<optional_project_id>
# GOOGLE_CLOUD_LOCATION=<optional_location>
# GOOGLE_CLIENT_ID=<optional_google_oauth_client_id>
# SMTP_USER=<optional_smtp_user>
# SMTP_PASS=<optional_smtp_password>
# Resident update emails are separately enabled and require resident opt-in.
# PULSO_EMAIL_NOTIFICATIONS=true
# PULSO_PUBLIC_BASE_URL=https://<public_pulso_hostname>
# RECAPTCHA_SECRET_KEY=<optional_recaptcha_secret>
# Explicit loopback-only development CAPTCHA. Leave disabled in production.
# PULSO_ENV=development
# PULSO_RECAPTCHA_LOCAL_TEST=true
# PHILSYS_SANDBOX=<optional_true_or_false>
# PHILSYS_API_ID=<optional_api_id>
# PHILSYS_API_SECRET=<optional_api_secret>
# PHILSYS_API_ENDPOINT=<optional_api_endpoint>
# PHILSYS_TIMEOUT_SEC=<optional_timeout_seconds>
# PHILSYS_QR_VERIFY_URL=<optional_qr_verify_url>
# PHILSYS_EVERIFY_URL=<optional_everify_url>
# PHILSYS_QR_COOKIE=<optional_qr_cookie>
# PHILSYS_PUBLIC_KEY=<optional_public_key>

# Optional local controls. Leave unset unless your development flow needs them.
# DEV_CREATE_ALL=true
# AI_DISABLED=true

# External referrals: an explicit approver delegation is required.
# PULSO_REFERRAL_APPROVER_ROLES=city_engineer,asst_city_engineer
# Keep email disabled until an approved CED sending/reply mailbox is configured.
PULSO_REFERRALS_ENABLED=false
# PULSO_REFERRAL_REPLY_TO=<monitored_CED_mailbox>
# SMTP_USER=<approved_sending_mailbox>
# SMTP_PASS=<mailbox_app_password>
# PULSO_REFERRAL_SMTP_HOST=smtp.gmail.com
# PULSO_REFERRAL_SMTP_PORT=465
