# Copy these names into ignored backend/.env.local. Never commit real values.
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=
# Optional. Leave unset to use the approved default sender name on the account.
SEMAPHORE_SENDER_NAME=
# Disabled until the LGU approves automatic staff priority alerts.
PULSO_ENABLE_PRIORITY_SMS=false
# To select PhilSMS, set SMS_PROVIDER=philsms and configure both fields below.
# Keep disabled until PhilSMS confirms why the pilot plain requests became Voice.
PHILSMS_ENABLE_OUTBOUND=false
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=

# To select IPROG SMS, set SMS_PROVIDER=iprogsms and configure the token below.
# Keep outbound disabled until a controlled handset test and network coverage check pass.
IPROG_SMS_ENABLE_OUTBOUND=false
IPROG_SMS_API_TOKEN=
# Set true only after an approved custom sender is active for Smart/TNT.
IPROG_SMS_ALLOW_SMART_TNT=false

# To select TextBee Android Gateway, set SMS_PROVIDER=textbee and configure below.
TEXTBEE_ENABLE_OUTBOUND=false
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
