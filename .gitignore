# Root .gitignore for PULSO

# Environment variables
.env
*.env
*.env.local
backend/.env.local
backend/.env
frontend/.env
**/.env.*
!.env.example
!**/.env.example
.venv/
**/.venv/
backend/google-credentials.json
*.pem
*.key

# Python Caches
__pycache__/
*.py[cod]
*$py.class

# IDE and System Files
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
~$*

# Node modules and build files
node_modules/
dist/
dist-ssr/
build/
.dart_tool/
.pub-cache/
.pub/

# Local databases
*.db
*.sqlite3

# Large APK files
*.apk
frontend/public/apk/

# Logs and transient text files
*.log
*.txt
backend/logs/
backend/logs/ocr_scans/

# Uploads
backend/uploads/
uploads/

# Scratch & Temporary files
scratch/
backend/scratch/
.agent/
diag_out.json
*.pptx
