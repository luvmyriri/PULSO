{
  "name": "PULSO - Caloocan City Citizen Portal",
  "short_name": "PULSO",
  "description": "Report utility hazards and road damage directly to Caloocan City Engineering.",
  "start_url": "/?mode=standalone",
  "scope": "/",
  "id": "/?mode=standalone",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#F7F9FC",
  "theme_color": "#F7F9FC",
  "orientation": "portrait-primary",
  "categories": ["government", "utilities", "productivity"],
  "icons": [
    {
      "src": "/pulso-app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pulso-app-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/pulso-app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pulso-app-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
