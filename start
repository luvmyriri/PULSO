#!/usr/bin/env bash
echo "============================================================"
echo "              PULSO - CITY ENGINEERING SYSTEM"
echo "       Local Government Operations & Citizen Portal"
echo "============================================================"

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "[1/3] Starting FastAPI Backend on http://localhost:33159..."
(cd "$DIR/backend" && python main.py) &

echo "[2/3] Starting Vite Frontend on http://localhost:5173..."
(cd "$DIR/frontend" && npm run dev) &

sleep 3
echo "Opening browser at http://localhost:5173..."
if command -v xdg-open > /dev/null; then
  xdg-open http://localhost:5173
elif command -v open > /dev/null; then
  open http://localhost:5173
fi

wait
